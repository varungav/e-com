# ─────────────────────────────────────────────────────────────
# Supabase credentials — get these from your Supabase project:
# https://supabase.com/dashboard/project/_/settings/api
# ─────────────────────────────────────────────────────────────

# Project URL (Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Anon / public key (Settings > API > Project API keys > anon public)
# Safe to expose in the browser — RLS policies protect your data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (Settings > API > Project API keys > service_role)
# SECRET — server-side only. Used for admin tasks (e.g. setting user roles).
# Never expose this to the browser / never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# App config
# ─────────────────────────────────────────────────────────────

# Base URL of this app, used for auth email redirects (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Razorpay — get both from https://dashboard.razorpay.com/app/keys
# Start with the TEST keys (rzp_test_...) while developing.
# ─────────────────────────────────────────────────────────────

# Key ID — public, safe to expose in the browser
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Key secret — SECRET, server-side only. Used to create orders and verify
# payment signatures. Never expose this to the browser.
RAZORPAY_KEY_SECRET=
